DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=maktender
DB_SCHEMA=maktender
DB_USER=postgres
DB_PASSWORD="<postgres-password>"
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60

DJANGO_SECRET_KEY="<generate-a-strong-random-secret>"
PASSWORD_PEPPER="<generate-a-separate-random-secret>"

ERP_URL=https://erp.mak.mn
ERP_DB=mak
ERP_AUTH_TIMEOUT=15
ERP_VERIFY_SSL=true

EMAIL_HOST_PASSWORD="<email-account-password>"

# Vendor-facing web origin used in tender invitation emails.
TENDER_PUBLIC_URL=https://tender.mak.mn

# Comma-separated Tbltenderuser.userid values allowed to read business audit logs.
AUDIT_LOG_VIEWER_USER_IDS=
